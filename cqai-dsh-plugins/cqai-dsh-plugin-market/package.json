{
  "name": "cqai-dsh-plugin-market",
  "version": "0.1.0",
  "description": "CQAI branding and curated policy for the DSH Community Market",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo No tests yet"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "dsh-community-market": "^0.1.0-dev.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "dsh-community-market": "workspace:*",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.0",
    "unrun": "^0.3.1"
  }
}
