{
  "name": "dsh-skill-mcp-panel",
  "version": "2.1.3",
  "description": "Desktop-adapted dsh-skill-mcp-panel with Skills and MCP inside plugin management",
  "homepage": "https://github.com/Fishquito7/dsh-skill-mcp-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fishquito7/dsh-skill-mcp-panel.git"
  },
  "bugs": {
    "url": "https://github.com/Fishquito7/dsh-skill-mcp-panel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "mcp"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "cqai-dsh-plugin-market"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^5.0.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "bin": {
    "dsh-panel": "lib/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs",
    "prepack": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test-desktop-slots.mjs"
  },
  "files": [
    "lib",
    "assets",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "26.2.0",
    "typescript": "6.0.3"
  }
}
