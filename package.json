{
  "name": "ebao-studio",
  "private": true,
  "description": "Pure official DeepSeek Harness Desktop; ebao integrations are retained as inactive source.",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "setup": "yarn upstream:init && yarn upstream:install && yarn upstream:prepare-electron",
    "dev": "node scripts/official-desktop.mjs dev",
    "start": "node scripts/official-desktop.mjs start",
    "build": "node scripts/official-desktop.mjs build",
    "typecheck": "node scripts/official-desktop.mjs typecheck",
    "test:launcher": "node --test scripts/official-desktop.test.mjs",
    "test:desktop": "node scripts/official-desktop.mjs test",
    "test": "yarn test:launcher && yarn test:desktop",
    "check:layout": "node scripts/verify-layout.mjs",
    "check": "yarn check:layout && yarn test:launcher && yarn build && yarn typecheck && yarn test:desktop",
    "package:dir": "node scripts/official-desktop.mjs package:dir",
    "dist:mac:arm64": "node scripts/official-desktop.mjs package:mac:arm64",
    "dist:mac:x64": "node scripts/official-desktop.mjs package:mac:x64",
    "dist:win": "node scripts/official-desktop.mjs package:win:x64",
    "upstream:init": "git submodule update --init --recursive -- deepseek-harness",
    "upstream:version": "node scripts/official-desktop.mjs version",
    "upstream:install": "node scripts/official-desktop.mjs install",
    "upstream:build": "node scripts/official-desktop.mjs build",
    "upstream:build:official": "node scripts/official-desktop.mjs build",
    "upstream:prepare-electron": "node scripts/official-desktop.mjs prepare:electron",
    "upstream:repair-install": "node scripts/official-desktop.mjs repair-install"
  }
}
