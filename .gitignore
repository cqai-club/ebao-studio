.DS_Store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
node_modules/
*.tsbuildinfo
.build/

dsh-plugin-desktop/dist/
dsh-plugin-desktop/lib/
dsh-community-market/lib/
cqai-dsh-plugins/*/lib/

# Third-party runtimes land at 250 MB+ and are never source. `vendor/*/README.md`
# carries the fetch command; an absent tree is an explicit build failure rather
# than a silent one.
vendor/matrixmedia/*/*.exe
vendor/matrixmedia/*/matrixmedia-win-x64/

.env.yarn

.portable/
__pycache__/
*.pyc
dsh-desktop-next/lib/
dsh-desktop-next/dist/
dsh-desktop-next/.desktop-next/
